# Reference template only. ./scripts/init-local.sh creates .env and random credentials.
# Keep the generated .env file out of Git.
WEB_PORT=8080
ASTRBOT_WEB_PORT=6185
# Local HTTP testing uses false; set true on a server behind Tailscale Serve HTTPS.
COOKIE_SECURE=false
TIMEZONE=Asia/Shanghai
APP_UID=1000
APP_GID=1000

# Generated by scripts/init-local.sh; never use these example values as credentials.
WEB_PASSWORD=
SESSION_SECRET=
SERVICE_API_TOKEN=

# Fill this only after creating a scoped AstrBot OpenAPI key for proactive IM sending.
ASTRBOT_API_KEY=
ASTRBOT_IMAGE=soulter/astrbot:v4.28.1

# Optional daily-brief content modules. Weather requires a private location.
WEATHER_LOCATION_NAME=
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
# Comma-separated RSS/Atom feed URLs; up to four feeds and four headlines are used.
NEWS_RSS_URLS=
